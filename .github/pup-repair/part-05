+        local name = trim_string(raw[i])
+        if PUPPETMASTER_MANEUVERS[name] ~= true then
+            error(('%s[%d] has unsupported maneuver %q'):format(path_name, i, name))
+        end
+        out[i] = name
+    end
+    return out
