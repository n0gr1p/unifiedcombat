+local function normalize_puppetmaster_pattern(value, default_value, path_name)
+    if value == nil then
+        return clone_value(default_value)
+    end
+    local raw = {}
+    if type(value) == 'string' then
+        if value:sub(1, 1) == '|' or value:sub(-1) == '|' or value:find('||', 1, true) then
+            error(path_name .. ' contains an empty maneuver')
+        end
+        for token in value:gmatch('[^|]+') do
+            raw[#raw + 1] = trim_string(token)
+        end
+    elseif type(value) == 'table' then
+        local count = 0
+        for key in pairs(value) do
+            count = count + 1
+            if type(key) ~= 'number' or key % 1 ~= 0 or key < 1 then
+                error(path_name .. ' must be a contiguous array')
+            end
+        end
+        if count ~= #value then
+            error(path_name .. ' must be a contiguous array')
+        end
+        for i = 1, #value do
+            raw[#raw + 1] = value[i]
+        end
+    else
+        error(path_name .. ' must be an array or pipe-delimited string')
+    end
+    if #raw < 1 or #raw > 3 then
+        error(path_name .. ' must contain one to three maneuvers')
+    end
+    local out = {}
