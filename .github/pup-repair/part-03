+    internal static List<object?> ParsePuppetmasterManeuverPattern(string value)
+    {
+        var allowed = new HashSet<string>(StringComparer.Ordinal)
+        {
+            "Fire Maneuver",
+            "Ice Maneuver",
+            "Wind Maneuver",
+            "Earth Maneuver",
+            "Thunder Maneuver",
+            "Water Maneuver",
+            "Light Maneuver",
+            "Dark Maneuver",
+        };
+        var pattern = SplitPipeList(value);
+        if (pattern.Count is < 1 or > 3)
+        {
+            throw new InvalidDataException("Puppetmaster maneuver pattern must contain one to three maneuvers.");
+        }
+        for (var i = 0; i < pattern.Count; i++)
+        {
+            var name = pattern[i]?.ToString() ?? "";
+            if (!allowed.Contains(name))
+            {
+                throw new InvalidDataException($"Unsupported Puppetmaster maneuver at slot {i + 1}: {name}");
+            }
+        }
+        return pattern;
+    }
+
+    private static StructuredProfileNode? BuildPuppetmaster(
+        JsonObject flatProfile,
+        StructuredProfileV2Identity identity
+    )
+    {
+        var isPuppetmasterProfile = string.Equals(
+            SafeJobComponent(identity.MainJob),
+            "PUP",
+            StringComparison.Ordinal
+        );
+        if (!isPuppetmasterProfile)
+        {
+            if (ReadOptionalBool(flatProfile, "puppetmaster_enabled", false))
+            {
+                throw new InvalidDataException("Puppetmaster automation configuration requires main job PUP.");
+            }
+            return null;
+        }
+
+        var pattern = ParsePuppetmasterManeuverPattern(
+            ReadString(
+                flatProfile,
+                "puppetmaster_maneuver_pattern",
+                "Fire Maneuver|Fire Maneuver|Light Maneuver"
+            )
+        );
+        return new StructuredProfileNode()
+            .Add("enabled", ReadOptionalBool(flatProfile, "puppetmaster_enabled", false))
+            .Add(
+                "activate_if_missing",
+                ReadOptionalBool(flatProfile, "puppetmaster_activate_if_missing", true)
+            )
+            .Add(
+                "deploy_on_combat_start",
+                ReadOptionalBool(flatProfile, "puppetmaster_deploy_on_combat_start", true)
+            )
+            .Add(
+                "maneuvers",
+                new StructuredProfileNode()
+                    .Add(
+                        "enabled",
+                        ReadOptionalBool(flatProfile, "puppetmaster_maneuvers_enabled", true)
+                    )
+                    .Add("pattern", pattern)
+                    .Add(
+                        "post_activate_quiet_seconds",
+                        ReadBoundedInt(
+                            flatProfile,
+                            "puppetmaster_post_activate_quiet_seconds",
+                            120,
+                            0,
+                            300
+                        )
+                    )
+                    .Add(
+                        "safe_burden_ceiling",
+                        ReadBoundedInt(
+                            flatProfile,
+                            "puppetmaster_safe_burden_ceiling",
+                            30,
+                            0,
+                            32
+                        )
+                    )
+            );
